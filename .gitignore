.env
.env.*
*.pem
*.key
*.p12

# Go test, coverage and profiling output
*.test
*.out
*.prof
coverage.html

# Logs
*.log

# macOS and editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
